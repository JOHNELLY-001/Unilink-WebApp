# ── UniLink server environment ──
# Copy to .env and fill in real values. Never commit .env to version control.

# Runtime
NODE_ENV=development
PORT=5000

# Neon Postgres connection string (Neon HTTP driver uses port 443)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-another-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth client ID (Google Sign-In)
GOOGLE_CLIENT_ID=

# Frontend origin(s) allowed by CORS — comma-separated, no trailing slashes.
# Example: https://unilink-web-app.vercel.app,https://unilink-web-app-git-main.vercel.app
CLIENT_URL=http://localhost:5173
