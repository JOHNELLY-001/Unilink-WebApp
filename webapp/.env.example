# ── UniLink webapp environment ──
# Copy to .env and fill in real values.

# Backend API base URL (no trailing slash).
# In development: http://localhost:5000/api/v1 (or leave unset — that's the default)
# In production (Vercel): leave unset or set to /api/v1 so requests go through
# the Vercel rewrite proxy (same-origin → cookies stay first-party).
VITE_API_BASE_URL=


# Google OAuth client ID (same value as the server's GOOGLE_CLIENT_ID).
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
# Authorized JavaScript origins must include http://localhost:5173 (and your deployed URL).
VITE_GOOGLE_CLIENT_ID=
